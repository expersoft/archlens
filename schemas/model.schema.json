{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlens.local/model.schema.json",
  "title": "archlens model",
  "type": "object",
  "required": [
    "model"
  ],
  "properties": {
    "archlens": {
      "type": "string",
      "pattern": "^2\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "properties": {
      "description": "property catalog (archlens.json)",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "string[]"
            ]
          },
          "values": {
            "type": "array"
          },
          "appliesTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "elements"
      ],
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "view.schema.json"
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changelogEntry"
      }
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "resource",
            "capability",
            "value-stream",
            "course-of-action",
            "business-actor",
            "business-role",
            "business-collaboration",
            "business-interface",
            "business-process",
            "business-function",
            "business-interaction",
            "business-event",
            "business-service",
            "business-object",
            "contract",
            "representation",
            "product",
            "application-component",
            "application-collaboration",
            "application-interface",
            "application-function",
            "application-interaction",
            "application-process",
            "application-event",
            "application-service",
            "data-object",
            "node",
            "device",
            "system-software",
            "technology-collaboration",
            "technology-interface",
            "path",
            "communication-network",
            "technology-function",
            "technology-process",
            "technology-interaction",
            "technology-event",
            "technology-service",
            "artifact",
            "equipment",
            "facility",
            "distribution-network",
            "material",
            "stakeholder",
            "driver",
            "assessment",
            "goal",
            "outcome",
            "principle",
            "requirement",
            "constraint",
            "meaning",
            "value",
            "work-package",
            "deliverable",
            "implementation-event",
            "plateau",
            "gap",
            "grouping",
            "location"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external": {
          "type": "boolean"
        },
        "c4": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "person",
                "softwareSystem",
                "container",
                "component",
                "deploymentNode",
                "infrastructureNode"
              ]
            }
          }
        },
        "parent": {
          "type": "string"
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "owner": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "inferred": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "alta",
            "média",
            "baixa",
            "high",
            "medium",
            "low"
          ]
        },
        "source": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "draft",
            "planned",
            "active",
            "deprecated",
            "retired"
          ]
        },
        "statusReason": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "enum": [
            "composition",
            "aggregation",
            "assignment",
            "realization",
            "serving",
            "access",
            "influence",
            "triggering",
            "flow",
            "specialization",
            "association"
          ]
        },
        "description": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "accessType": {
          "enum": [
            "read",
            "write",
            "readwrite",
            "access"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "inferred": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "draft",
            "planned",
            "active",
            "deprecated",
            "retired"
          ]
        },
        "statusReason": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "prompt",
            "repo",
            "doc",
            "manual"
          ]
        },
        "ref": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "changelogEntry": {
      "type": "object",
      "required": [
        "id",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "summary": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "draft",
              "planned",
              "active",
              "deprecated",
              "retired"
            ]
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
